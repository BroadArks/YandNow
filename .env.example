# ============================================================
#  Y&Now website — environment variables
#  Copy this file to `.env.local` and fill in the real values.
#
#  The site reads PUBLISHED blog posts from Supabase using the
#  public anon key (guarded by row-level security). If these are
#  left unset, the blog transparently falls back to the bundled
#  seed posts in lib/blog.ts, so the site still builds & renders.
# ============================================================

# Supabase project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Public anon key — Project Settings → API → Project API keys → anon public
# Safe to expose in the browser; only reads published posts (see RLS policy).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
